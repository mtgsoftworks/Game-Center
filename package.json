{
  "name": "game-center",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "package/*",
    "package/games/*"
  ],
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "start": "npm-run-all --parallel start:frontend start:backend",
    "start:frontend": "yarn workspace game-center-frontend start",
    "start:backend": "yarn workspace game-center-backend start",
    "build": "lerna run build",
    "clean": "lerna clean",
    "test": "lerna run test"
  },
  "devDependencies": {
    "lerna": "^8.1.9",
    "npm-run-all": "^4.1.5"
  }
}